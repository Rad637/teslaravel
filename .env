APP_NAME=SISFARM
APP_ENV=local
APP_KEY=base64:OmRlXNlCMMCoQMTyDI00HglQ/nZEN29gXjCLo1LW6ag=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

# ===== KONFIGURASI DATABASE MYSQL =====
# Sesuaikan dengan pengaturan database kamu
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisfarm_db       # nama database yang sudah kamu buat di phpMyAdmin/MySQL
DB_USERNAME=root              # username MySQL kamu
DB_PASSWORD=                  # password MySQL kamu (kosongkan jika tidak ada)

# Session disimpan di database (bisa juga pakai 'file')
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
